{
  "manifest_version": 3,
  "name": "Sauce for TCG Collector",
  "description": "Sauce for TCG Collector is a browser extension that adds printing of binder placeholders and expansion logos to tcgcollector.com.",
  "version": "1.0",
  "icons": {
    "16": "dist/icons/icon-16.png",
    "32": "dist/icons/icon-32.png",
    "48": "dist/icons/icon-48.png",
    "128": "dist/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": [
        "https://www.tcgcollector.com/*"
      ],
      "js": [
        "dist/sauce.min.js"
      ],
      "css": [
        "dist/sauce.min.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/*"
      ],
      "matches": [
        "https://www.tcgcollector.com/*"
      ]
    }
  ]
}
